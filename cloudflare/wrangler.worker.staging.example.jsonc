{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "weknora-chatgpt-mcp-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-04",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "define": { "__MCP_ORIGIN__": "\"https://weknora-mcp-chuyuai-staging.pages.dev\"" },
  "vars": { "WEKNORA_BASE_URL": "https://weknora.weixin.qq.com/api/v1" },
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "REPLACE_WITH_STAGING_KV_ID" }]
}
